# Cat Health Tracker — переменные окружения
# Скопируйте этот файл в .env и измените значения при необходимости.

# --- Основные ---
APP_NAME=Cat Health Tracker
DEBUG=true
HOST=127.0.0.1
PORT=8000

# --- База данных SQLite ---
# Путь к файлу БД (относительно корня проекта или абсолютный)
# DATABASE_URL и ASYNC_DATABASE_URL формируются автоматически из DB_PATH
DB_PATH=data/cat_health.db
# DATABASE_URL=sqlite:///data/cat_health.db
# ASYNC_DATABASE_URL=sqlite+aiosqlite:///data/cat_health.db

# --- Каталоги ---
UPLOADS_DIR=uploads
DATA_DIR=data

# --- OCR (Tesseract) ---
# Укажите полный путь к tesseract, если он не найден в PATH
# Windows пример: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# --- Яндекс Почта (IMAP + OAuth2) ---
# Заполняется при настройке интеграции (Этап 5).
# Инструкция: создайте OAuth-приложение на https://oauth.yandex.ru/client/new
# Права: imap — доступ к почте через IMAP.
YANDEX_EMAIL=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REFRESH_TOKEN=
YANDEX_IMAP_HOST=imap.yandex.ru
YANDEX_IMAP_PORT=993
