# Cat Health Tracker — переменные окружения
# Скопируйте этот файл в .env и измените значения при необходимости.

# --- Основные ---
APP_NAME=Cat Health Tracker
DEBUG=true
HOST=127.0.0.1
PORT=8000

# --- База данных SQLite ---
# Путь к файлу БД (относительно корня проекта или абсолютный)
# Если DATABASE_URL задан — он имеет приоритет над DB_PATH
DB_PATH=data/cat_health.db
# DATABASE_URL=sqlite:///data/cat_health.db

# --- Каталоги ---
UPLOADS_DIR=uploads
DATA_DIR=data

# --- OCR (Tesseract) ---
# Укажите полный путь к tesseract, если он не найден в PATH
# Windows пример: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
